      "exit_code": 2
    },
    {
      "expr": "(1))",
      "stdout": "",
      "stderr": "[rumblet] StaticError: unexpected token after expression\n",
      "exit_code": 2
    },
    {
      "expr": "(1) (2)",
      "stdout": "",
      "stderr": "[rumblet] StaticError: unexpected token after expression\n",
      "exit_code": 2
    },
    {
      "expr": "(1, 2)",
      "stdout": "1\n2\n",
      "stderr": "",
      "exit_code": 0
    }
  ]

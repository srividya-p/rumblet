{
  "summary": "Stream a single for clause and concatenate the return sequences, resetting the return iterator for each binding.",
  "cases": [
    {"expr": "for $x in (1,2,3) return $x + 10", "stdout": "11\n12\n13\n"},
    {"expr": "for $x in (2,null,2) return ($x,$x)", "stdout": "2\n2\nnull\nnull\n2\n2\n"},
    {"expr": "for $x in () return 1 div 0", "stdout": "()\n"},
    {"expr": "for $x in (1,2,3) return if ($x eq 2) then () else ($x,0)", "stdout": "1\n0\n3\n0\n"},
    {"expr": "let $x := (1,2) return ((for $x in $x return $x + 10), $x)", "stdout": "11\n12\n1\n2\n"},
    {"expr": "for $x in (1,2) return for $y in ($x, $x + 1) return [$x,$y]", "stdout": "[1,1]\n[1,2]\n[2,2]\n[2,3]\n"},
    {"expr": "for $x in (1, 1 div 0) return $x", "stdout": "", "exit_code": 2, "stderr": "[rumblet] DynamicError: division or remainder by zero\n"},
    {"expr": "for $x in $x return $x", "stdout": "", "exit_code": 2, "stderr": "[rumblet] StaticError: unbound variable: $x\n"},
    {"expr": "for $x in () return $y", "stdout": "", "exit_code": 2, "stderr": "[rumblet] StaticError: unbound variable: $y\n"},
    {"expr": "(for $x in 1 return $x), $x", "stdout": "", "exit_code": 2, "stderr": "[rumblet] StaticError: unbound variable: $x\n"},
    {"expr": "for $x 1 return $x", "stdout": "", "exit_code": 2, "stderr": "[rumblet] StaticError: expected 'in' after for variable\n"},
    {"expr": "for $x in 1", "stdout": "", "exit_code": 2, "stderr": "[rumblet] StaticError: expected 'return' after for clause\n"}
  ]
}
